{
  "name": "nostr-publish-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP-to-Nostr publishing gateway for Cloudflare Workers.",
  "license": "Unlicense",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251118.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0",
    "ws": "^8.18.3"
  }
}
